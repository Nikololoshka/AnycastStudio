# Copy to .env and fill in. Real environment variables win over this file.
# A commented line shows the default the server uses when the variable is unset.

# --- Core ---
# Required when DJANGO_DEBUG is off. Set DJANGO_DEBUG=1 for local development.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0

# Origin and host the browser uses: the Vite dev server in development.
# PUBLIC_ORIGIN=http://localhost:5173
# PUBLIC_HOST=localhost

# Comma-separated.
# CSRF_TRUSTED_ORIGINS=${PUBLIC_ORIGIN}
# DJANGO_ALLOWED_HOSTS=${PUBLIC_HOST},<host of PUBLIC_REDIRECT_ORIGIN>,localhost,127.0.0.1

# Origin the platforms send the OAuth redirect to. Defaults to PUBLIC_ORIGIN.
# Set it to an HTTPS tunnel (ngrok http 8000) when a platform refuses an http
# redirect, as TikTok's web apps do. The callback that lands there is sent on
# to PUBLIC_ORIGIN, where the session cookie is.
# PUBLIC_REDIRECT_ORIGIN=https://<name>.ngrok-free.app

# Trust X-Forwarded-For for the client address. Only behind a reverse proxy.
# TRUST_X_FORWARDED_FOR=0

# --- Storage ---
# MEDIA_ROOT=backend/media_files
# SQLITE_PATH=backend/db.sqlite3

# --- Redis ---
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=${REDIS_URL}

# --- Token encryption ---
# Required. Comma-separated "version:key" pairs, newest first; older keys only decrypt.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print('v1:' + Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# --- YouTube ---
# Google Cloud OAuth client of type "Web application", YouTube Data API v3 enabled.
# Authorised redirect URI: http://localhost:5173/api/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok ---
# TikTok for Developers app of platform type "Desktop", with Login Kit and the
# Content Posting API (Direct Post). Scopes: user.info.basic, video.publish.
# Redirect URI: http://localhost:5173/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram ---
# Meta app of type "Business" with Facebook Login for Business and the Instagram
# Graph API. The Instagram account must be a professional account linked to a
# Facebook Page. Scopes: instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement. Facebook accepts only an HTTPS
# redirect, so set PUBLIC_REDIRECT_ORIGIN and add to Valid OAuth Redirect URIs:
#   ${PUBLIC_REDIRECT_ORIGIN}/api/social/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
