# Copy to backend/.env and fill in. Never commit the filled file.
# Nothing in here belongs in a VITE_* variable: the frontend bundle is public.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Origin the browser uses, scheme included. OAuth redirect URIs are built from it.
# Locally this is the Vite dev server, which proxies /api to Django.
PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_HOST=localhost

# --- Database ---
# Leave unset to use backend/db.sqlite3. Set DATABASE_ENGINE=postgresql only once
# "database is locked" starts appearing in the worker log.
# SQLITE_PATH=
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Redis ---
# docker run -d --name anycast-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379/0

# --- Token encryption ---
# Comma-separated, newest first, so a key can be rotated without downtime.
# Format: v<N>:<urlsafe base64 of 32 bytes>
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print('v1:' + Fernet.generate_key().decode())"
# Losing every key means every user must reconnect every platform account.
# Back it up separately from the database.
TOKEN_ENCRYPTION_KEYS=

# --- YouTube ---
# Google Cloud console, OAuth client of type "Web application",
# YouTube Data API v3 enabled. Authorised redirect URI:
#   http://localhost:5173/api/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Facebook / Instagram (not in scope yet) ---
# FB_APP_ID=
# FB_APP_SECRET=
# FB_GRAPH_VERSION=v23.0

# --- Legacy desktop broker, removed once the web OAuth flow lands ---
CLIENT_TOKENS=
